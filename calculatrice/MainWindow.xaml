<Window x:Class="calculatrice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:calculatrice"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="400">
    <Grid Background="Black">
        <Grid>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

          
            <Grid.Resources>
                
                
                <Style x:Key="MyStyle" TargetType="{x:Type Control}">
                    <Setter Property="Margin" Value="8"/>
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontSize" Value="36"/>
                    <Setter Property="Padding" Value="8"/>
                    <Style.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="30"/>
                        </Style>
                    </Style.Resources>
                </Style>

                <Style x:Key="CLR" TargetType="{x:Type Control}">
                    <Setter Property="Margin" Value="8"/>
                    <Setter Property="Background" Value="Red"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontSize" Value="36"/>
                    <Setter Property="Padding" Value="10"/>
                    <Style.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Style.Resources>
                </Style>


                <Style x:Key="Egal" TargetType="{x:Type Control}">
                    <Setter Property="Margin" Value="8"/>
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Padding" Value="10"/>
                    <Style.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Style.Resources>
                </Style>
                <Style  TargetType="{x:Type Button}">
                    <Setter Property="Margin" Value="8"/>
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="36"/>
                    <Setter Property="Padding" Value="10"/>
                    <Style.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Style.Resources>
                </Style>
            </Grid.Resources>



            <!-- Ligne 0 : TextBox qui s'étend sur 4 colonnes -->
            <TextBox Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Display"
             FontSize="36"
             FontWeight="Bold"
             Background="#1A1A1A"
             Foreground="White"
             BorderThickness="0"
             Height="80"
             Margin="0 0 0 20"
             TextAlignment="Right"
             VerticalContentAlignment="Center"
             IsReadOnly="True"
             BorderBrush="Transparent"
             Padding="10" />


            <!-- Ligne 1 : Boutons 1, 2, 3, + -->
            <Button Grid.Row="1" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click" />
            <Button Grid.Row="1" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click" />
            <Button Grid.Row="1" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click" />
            <Button Grid.Row="2" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click" />
            <Button Grid.Row="2" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click" />
            <Button Grid.Row="2" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click" />
            <Button Grid.Row="3" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click" />
            <Button Grid.Row="3" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click" />
            <Button Grid.Row="3" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click" />
            <Button Grid.Row="4" Grid.Column="0" Name="BTN_0" Content="0" Click="BTN_0_Click" />
            <Button Grid.Row="1" Grid.Column="3" Name="BTN_Plus" Style="{StaticResource MyStyle}" Content="+" Click="BTN_Plus_Click" />
            <Button Grid.Row="2" Grid.Column="3" Name="BTN_Moins" Style="{StaticResource MyStyle}" Content="-" Click="BTN_Moins_Click" />
            <Button Grid.Row="3" Grid.Column="3" Name="BTN_Fois" Style="{StaticResource MyStyle}" Content="*" Click="BTN_Fois_Click" />
            <Button Grid.Row="4" Grid.Column="3" Name="BTN_Divisé" Style="{StaticResource MyStyle}" Content="/" Click="BTN_Divisé_Click" />
            <Button Grid.Row="4" Grid.Column="1" Name="BTN_CLR" Style="{StaticResource CLR}" Content="CLR" Click="BTN_CLR_Click" />
            <Button Grid.Row="4" Grid.Column="2" Name="BTN_Egal" Style="{StaticResource Egal}" Content="=" Click="BTN_Egal_Click" />


        </Grid>
        

    </Grid>
</Window>
