<Window x:Class="calculatrice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculatrice" Height="600" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <!-- Zone d'affichage -->
            <RowDefinition Height="*"/>
            <!-- Boutons -->
        </Grid.RowDefinitions>

        <!-- Zone d'affichage -->
        <TextBox x:Name="TB_Display"
                 Grid.Row="0"
                 FontSize="36"
                 FontWeight="Bold"
                 Foreground="White"
                 Background="Black"
                 BorderThickness="0"
                 TextAlignment="Right"
                 VerticalContentAlignment="Bottom"
                 IsReadOnly="True"
                 Margin="10"/>

        <!-- Grille des boutons -->
        <UniformGrid Grid.Row="1" Columns="4" Rows="5" Margin="5">
            <!-- Première ligne -->

            <Button x:Name="BTN_CLR" Content="C" Background="DarkGreen" Foreground="White" FontSize="24" Margin="5" Click="BTN_CLR_Click"/>
            <Button x:Name="BTN_Back" Content="⌫" Background="DarkGreen" Foreground="White" FontSize="24" Margin="5" Click="BTN_Back_Click"/>
            <Button x:Name="BTN_Pourcent" Content="%" Background="DarkGreen" Foreground="White" FontSize="24" Margin="5" Click="BTN_Pourcent_Click"/>
            <Button x:Name="BTN_Divisé" Content="/" Background="DarkGreen" Foreground="White" FontSize="24" Margin="5" Click="BTN_Divisé_Click"/>

            <!-- Deuxième ligne -->
            <Button x:Name="BTN_7" Content="7" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_8" Content="8" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_9" Content="9" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_Fois" Content="*" Background="DarkGreen" Foreground="White" FontSize="24" Margin="5" Click="BTN_Fois_Click"/>

            <!-- Troisième ligne -->
            <Button x:Name="BTN_4" Content="4" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_5" Content="5" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_6" Content="6" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_Moins" Content="-" Background="DarkGreen" Foreground="White" FontSize="24" Margin="5" Click="BTN_Moins_Click"/>

            <!-- Quatrième ligne -->
            <Button x:Name="BTN_1" Content="1" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_2" Content="2" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_3" Content="3" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_Plus" Content="+" Background="DarkGreen" Foreground="White" FontSize="24" Margin="5" Click="BTN_Plus_Click"/>

            <!-- Cinquième ligne -->
            <Button x:Name="BTN_PlusMinus" Content="±" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_PlusMinus_Click"/>
            <Button x:Name="BTN_0" Content="0" Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Click"/>
            <Button x:Name="BTN_Virgul" Content="," Background="#222" Foreground="LightGreen" FontSize="24" Margin="5" Click="BTN_Virgule_Click"/>
            <Button x:Name="BTN_Egal" Content="=" Background="Green" Foreground="White" FontSize="24" Margin="5" Click="BTN_Egal_Click"/>
        </UniformGrid>
    </Grid>
</Window>
